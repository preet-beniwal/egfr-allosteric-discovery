# ============ LARGE DATA FILES (regenerated by scripts) ============
data/raw/*.pdb
data/raw/*.fasta
data/processed/*.pdb
data/processed/*.pdbqt
data/processed/ligands/
data/results/poses/
data/results/test/

# ============ MD TRAJECTORIES (Phase 3, huge files) ============
data/md/*.xtc
data/md/*.trr
data/md/*.gro
data/md/*.tpr
data/md/*.edr
data/md/*.cpt

# ============ KEEP small scientific outputs ============
# (docking_scores.csv, top10_hits.csv, roc_analysis.png stay tracked)
!data/results/*.csv
!data/results/*.png

# ============ PYTHON ============
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
*.egg-info/

# ============ CONDA / ENV ============
.env
.venv/
*.log

# ============ OS JUNK ============
.DS_Store
Thumbs.db
*.swp
*~

# ============ EDITOR ============
.vscode/
.idea/
